<?xml version="1.0" encoding="UTF-8"?>

<!-- Beans to add to the current Application context definition -->

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
  		    http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <!--<context:component-scan base-package="org.openmrs.module.stockmanagement" />-->


    <!-- Wraps StockManagementService methods in DB transactions and OpenMRS interceptors,
    which set audit info like dateCreated, changedBy, etc.-->
    <bean id="stockmanagement.StockManagementService"
            class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
        <property name="transactionManager">
            <ref bean="transactionManager" />
        </property>
        <property name="target">
            <bean class="org.openmrs.module.stockmanagement.api.impl.StockManagementServiceImpl">
                <property name="dao">
                    <bean class="org.openmrs.module.stockmanagement.api.dao.StockManagementDao">
                        <property name="sessionFactory">
                            <ref bean="dbSessionFactory" />
                        </property>
                        <property name="searchSessionFactory" ref="searchSessionFactory"/>
                    </bean>
                </property>
            </bean>
        </property>
        <property name="preInterceptors">
            <ref bean="serviceInterceptors" />
        </property>
        <property name="postInterceptors">
            <list><ref bean="stockmanagement.inventoryWriteLockAdvice" /></list>
        </property>
        <property name="transactionAttributeSource">
            <ref bean="transactionAttributeSource" />
        </property>
    </bean>

    <!-- Adds StockManagementService to OpenMRS context so it can be accessed
    calling Context.getService(StockManagementService.class) -->
    <bean parent="serviceContext">
        <property name="moduleService">
            <list>
                <value>org.openmrs.module.stockmanagement.api.StockManagementService</value>
                <ref bean="stockmanagement.StockManagementService" />
            </list>
        </property>
    </bean>
    <bean id="stockmanagement.dispenseOperationDao" class="org.openmrs.module.stockmanagement.api.dao.DispenseOperationDao">
        <property name="sessionFactory" ref="dbSessionFactory" />
    </bean>
    <bean id="stockmanagement.inventoryWriteLockAdvice" class="org.openmrs.module.stockmanagement.api.dispensing.InventoryWriteLockAdvice">
        <property name="dao" ref="stockmanagement.dispenseOperationDao" />
    </bean>
    <bean id="stockmanagement.atomicStockDao" class="org.openmrs.module.stockmanagement.api.dao.StockManagementDao">
        <property name="sessionFactory" ref="dbSessionFactory" />
    </bean>
    <bean id="stockmanagement.AtomicDispensingService" class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
        <property name="transactionManager" ref="transactionManager" />
        <property name="preInterceptors" ref="serviceInterceptors" />
        <property name="transactionAttributeSource" ref="transactionAttributeSource" />
        <property name="target">
            <bean class="org.openmrs.module.stockmanagement.api.dispensing.AtomicDispensingServiceImpl">
                <property name="dao" ref="stockmanagement.dispenseOperationDao" />
                <property name="stockDao" ref="stockmanagement.atomicStockDao" />
                <property name="stockService" ref="stockmanagement.StockManagementService" />
                <property name="translator" ref="medicationDispenseTranslatorImpl" />
            </bean>
        </property>
    </bean>
    <bean parent="serviceContext">
        <property name="moduleService">
            <list>
                <value>org.openmrs.module.stockmanagement.api.dispensing.AtomicDispensingService</value>
                <ref bean="stockmanagement.AtomicDispensingService" />
            </list>
        </property>
    </bean>
</beans>
